ARG NVPN_E2E_BUILDER_IMAGE=rust:1.93-bookworm
ARG NVPN_E2E_RUNTIME_IMAGE=debian:bookworm-slim

FROM ${NVPN_E2E_BUILDER_IMAGE} AS builder
WORKDIR /app/nostr-vpn

ARG NVPN_E2E_BUILDER_APT_INSTALL=1
RUN case "$NVPN_E2E_BUILDER_APT_INSTALL" in \
        0|false|FALSE|False|no|NO|No|off|OFF|Off) ;; \
        *) apt-get update \
          && apt-get install -y --no-install-recommends libclang-dev libdbus-1-dev pkg-config \
          && rm -rf /var/lib/apt/lists/* ;; \
      esac

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY vendor ./vendor
COPY --from=cashu-service . /app/cashu-service
COPY --from=cashu-spilman-channels . /app/cashu_spilman_channels
COPY --from=fips . /app/fips

ARG NVPN_PATCH_LOCAL_FIPS=0

# Published FIPS crates are the default. The named context points at this repo
# unless an explicit local FIPS checkout is selected for cross-repo testing.
RUN case "$NVPN_PATCH_LOCAL_FIPS" in \
        1|true|TRUE|True|yes|YES|Yes|on|ON|On) \
          test -f /app/fips/crates/fips-core/Cargo.toml \
            && test -f /app/fips/crates/fips-endpoint/Cargo.toml \
            && test -f /app/fips/crates/fips-identity/Cargo.toml \
            || { echo "NVPN_PATCH_LOCAL_FIPS=1 requires NVPN_FIPS_REPO_PATH to point at a fips checkout" >&2; exit 1; }; \
          mkdir -p .cargo; \
          printf '[patch.crates-io]\nnvpn-fips-core = { path = "/app/fips/crates/fips-core" }\nnvpn-fips-endpoint = { path = "/app/fips/crates/fips-endpoint" }\nnvpn-fips-identity = { path = "/app/fips/crates/fips-identity" }\n' > .cargo/config.toml; \
          ;; \
      esac

# BuildKit cache mounts persist registry/git deps and target/ across builds.
# Refresh local source mtimes first: Docker preserves old worktree mtimes, while
# the mounted target cache can contain newer artifacts from another branch.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/nostr-vpn/target \
    find crates -type f \( -name '*.rs' -o -name 'Cargo.toml' \) -exec touch {} + \
    && if [ -d /app/fips/crates ]; then \
      find /app/fips/crates -type f \( -name '*.rs' -o -name 'Cargo.toml' \) -exec touch {} +; \
    fi \
    && cargo build --release -p nvpn -p nostr-vpn-web \
    && cp target/release/nvpn target/release/nostr-vpn-web /tmp/

FROM ${NVPN_E2E_RUNTIME_IMAGE} AS runtime
ARG NVPN_E2E_RUNTIME_APT_INSTALL=1
RUN case "$NVPN_E2E_RUNTIME_APT_INSTALL" in \
        0|false|FALSE|False|no|NO|No|off|OFF|Off) ;; \
        *) apt-get update \
          && apt-get install -y --no-install-recommends ca-certificates curl dnsutils iperf3 iproute2 iptables iputils-ping libdbus-1-3 netcat-openbsd nftables procps tcpdump wireguard-tools \
          && rm -rf /var/lib/apt/lists/* ;; \
      esac

COPY --from=builder /tmp/nvpn /usr/local/bin/nvpn
COPY --from=builder /tmp/nostr-vpn-web /usr/local/bin/nostr-vpn-web

ENV RUST_LOG=info
