#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT/scripts/local-fips-workspace.sh"
if [[ -f "$ROOT/scripts/release_common.sh" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/scripts/release_common.sh"
  resolve_shared_build_metadata "$ROOT"
fi
ANDROID_DIR="$ROOT/android"

find_gradle() {
  local cached
  cached="$(find "$HOME/.gradle/wrapper/dists" -path '*/bin/gradle' -type f 2>/dev/null | sort -V | grep -v '/gradle-9\.' | tail -n 1 || true)"
  if [[ -n "$cached" ]]; then
    printf '%s\n' "$cached"
    return
  fi
  if command -v gradle >/dev/null 2>&1; then
    command -v gradle
    return
  fi
  if [[ -z "$cached" ]]; then
    cached="$(find "$HOME/.gradle/wrapper/dists" -path '*/bin/gradle' -type f 2>/dev/null | sort -V | tail -n 1 || true)"
  fi
  if [[ -n "$cached" ]]; then
    printf '%s\n' "$cached"
    return
  fi
  echo "gradle not found; install Gradle or run from a machine with a cached Gradle wrapper distribution" >&2
  exit 1
}

if [[ -z "${ANDROID_HOME:-}" && -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
fi
if [[ -n "${ANDROID_NDK_HOME:-}" && ! -d "$ANDROID_NDK_HOME" ]]; then
  unset ANDROID_NDK_HOME
fi
if [[ -n "${NDK_HOME:-}" && ! -d "$NDK_HOME" ]]; then
  unset NDK_HOME
fi
if [[ -z "${ANDROID_NDK_HOME:-}" && -n "${ANDROID_HOME:-}" ]]; then
  latest_ndk="$(find "$ANDROID_HOME/ndk" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort -V | tail -n 1 || true)"
  if [[ -n "$latest_ndk" ]]; then
    export ANDROID_NDK_HOME="$latest_ndk"
  fi
fi
export NDK_HOME="${ANDROID_NDK_HOME:-${NDK_HOME:-}}"

nvpn_prepare_local_fips_workspace "$ROOT"

GRADLE="$(find_gradle)"
gradle_args=()
if [[ -n "${NVPN_FIPS_REPO_PATH:-}" ]]; then
  local_fips_cargo="$(command -v cargo)"
  local_fips_cargo_ndk="$(command -v cargo-ndk)"
  if [[ "${NVPN_LOCAL_FIPS_PATCH_PRECONFIGURED:-0}" != "1" ]]; then
    [[ "$local_fips_cargo" == "$NVPN_LOCAL_FIPS_LOCK_DIR/cargo-wrapper/cargo" ]] || {
      echo "local FIPS Android build did not resolve the owned Cargo wrapper" >&2
      exit 1
    }
  fi
  [[ -x "$local_fips_cargo_ndk" ]] || {
    echo "local FIPS Android build could not resolve cargo-ndk" >&2
    exit 1
  }
  gradle_args+=("-PnvpnCargoExecutable=$local_fips_cargo")
  gradle_args+=("-PnvpnCargoNdkExecutable=$local_fips_cargo_ndk")
fi
cmd="${1:-assembleDebug}"
if [[ $# -gt 0 ]]; then
  shift
fi
if [[ -n "${NVPN_FIPS_REPO_PATH:-}" ]]; then
  nvpn_verify_local_fips_metadata \
    "$ROOT" \
    "${NVPN_ANDROID_FIPS_METADATA_RECEIPT:-$ROOT/artifacts/mobile-android/fips-linkage.json}"
  case "$cmd" in
    release|assembleRelease)
      nvpn_force_rebuild_local_fips_target \
        "$ROOT" aarch64-linux-android release \
        "${NVPN_ANDROID_FIPS_REBUILD_MARKER:-$ROOT/artifacts/mobile-android/fips-rebuild-aarch64-linux-android.marker}"
      ;;
  esac
fi

run_gradle() {
  local task="$1"
  shift
  if [[ ${#gradle_args[@]} -gt 0 ]]; then
    env -u NVPN_FIPS_REPO_PATH "$GRADLE" -p "$ANDROID_DIR" \
      "${gradle_args[@]}" "$task" "$@"
  else
    env -u NVPN_FIPS_REPO_PATH "$GRADLE" -p "$ANDROID_DIR" "$task" "$@"
  fi
}

case "$cmd" in
  build|assembleDebug|debug)
    run_gradle :app:assembleDebug "$@"
    ;;
  release|assembleRelease)
    run_gradle :app:bundleRelease "$@"
    "$ROOT/scripts/prepare-android-release-from-bundle.sh"
    ;;
  install|installDebug)
    run_gradle :app:installDebug "$@"
    ;;
  *)
    run_gradle "$cmd" "$@"
    ;;
esac
