#!/usr/bin/env bash

set -Eeuo pipefail

HARNESS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "${NVPN_IOS_RELEASE_SOURCE_ROOT:-$HARNESS_ROOT}" && pwd)"
# shellcheck disable=SC1091
source "$HARNESS_ROOT/scripts/release_common.sh"

load_release_env "$ROOT"
if [[ -n "${NVPN_IOS_ASC_ROOT:-}" && -z "${NVPN_ASC_ROOT:-}" ]]; then
  export NVPN_ASC_ROOT="$NVPN_IOS_ASC_ROOT"
fi
load_appstoreconnect_defaults
resolve_ios_build_metadata "$ROOT"

IOS_DIR="$ROOT/ios"
DIST_DIR="$ROOT/dist/ios"
ARCHIVE_PATH="$DIST_DIR/NostrVpnIos.xcarchive"
EXPORT_DIR="$DIST_DIR/export"
EXPORT_OPTIONS="$DIST_DIR/ExportOptions.plist"
FROZEN_DIR="$DIST_DIR/frozen"
FROZEN_ARCHIVE_RECEIPT="$FROZEN_DIR/archive-receipt.json"
FROZEN_ADHOC_EXPORT_DIR="$FROZEN_DIR/release-testing-export"
FROZEN_ADHOC_UNPACK_DIR="$FROZEN_DIR/release-testing-unpacked"
FROZEN_ADHOC_RECEIPT="$FROZEN_DIR/release-testing-receipt.json"
FROZEN_APPSTORE_UNPACK_DIR="$FROZEN_DIR/app-store-unpacked"
FROZEN_APPSTORE_RECEIPT="$FROZEN_DIR/app-store-receipt.json"
FROZEN_MOBILE_RECEIPT="$FROZEN_DIR/physical-mobile-receipt.json"
FROZEN_MOBILE_JOIN_RECEIPT="${NVPN_RELEASE_JOIN_RESULT_DIR:-$ROOT/artifacts/mobile-release-join}/summary.json"
FROZEN_MOBILE_JOIN_IOS_VARIANT_RECEIPT="${NVPN_RELEASE_JOIN_IOS_VARIANT_RECEIPT:-${NVPN_RELEASE_JOIN_RESULT_DIR:-$ROOT/artifacts/mobile-release-join}/ios-join-test-variant.json}"
FROZEN_DESKTOP_MOBILE_JOIN_RECEIPT="${NVPN_RELEASE_JOIN_RESULT_DIR:-$ROOT/artifacts/mobile-release-join}/macos/summary.json"
FROZEN_MOBILE_WG_RECEIPT="${NVPN_RELEASE_GATE_LOG_DIR:-$ROOT/artifacts/release-gate-logs}/mobile-network/ios-wireguard-dns.json"
FROZEN_MOBILE_UNDERLAY_RECEIPT="${NVPN_RELEASE_GATE_LOG_DIR:-$ROOT/artifacts/release-gate-logs}/mobile-network/ios-underlay-lifecycle.json"
FROZEN_GATE_SEAL="$FROZEN_DIR/physical-gate-seal.json"
FROZEN_TOOL="$HARNESS_ROOT/scripts/ios_frozen_archive.py"
PROJECT="$IOS_DIR/NostrVpnIos.xcodeproj"
SCHEME="${NVPN_IOS_SCHEME:-NostrVpnIos}"
CONFIGURATION="${NVPN_IOS_CONFIGURATION:-Release}"
MIN_VERSION="${NVPN_IOS_MIN_VERSION:-17.0}"
: "${NVPN_IOS_TEAM_ID:?NVPN_IOS_TEAM_ID is required in the private release environment}"
TEAM_ID="$NVPN_IOS_TEAM_ID"
BUNDLE_ID="${NVPN_IOS_BUNDLE_ID:-$NVPN_DEFAULT_IOS_BUNDLE_ID}"
PACKET_TUNNEL_BUNDLE_ID="${NVPN_IOS_PACKET_TUNNEL_BUNDLE_ID:-$BUNDLE_ID.PacketTunnel}"
APP_GROUP_IDENTIFIER="${NVPN_IOS_APP_GROUP_IDENTIFIER:-group.$BUNDLE_ID.shared}"
PROVISIONING_ENV="$DIST_DIR/provisioning.env"
IOS_INTERNAL_ONLY="${NVPN_IOS_INTERNAL_ONLY:-false}"
IOS_UPLOAD_TRANSPORT="${NVPN_IOS_UPLOAD_TRANSPORT:-HTTP}"

usage() {
  cat <<'EOF'
usage: ./scripts/ios-build <command>

commands:
  ios-rust              build Rust app-core for ios-sim + iphoneos
  ios-xcframework       build the app-core xcframework
  ios-project           regenerate the Xcode project from project.yml
  ios-archive           create or verify the one frozen App Store archive
  ios-release-testing   export an Ad Hoc app from that frozen archive
  ios-export            export App Store IPA from the verified frozen archive
  ios-upload-preflight  validate the exact upload without contacting Apple
  ios-upload            upload the exact verified frozen-archive IPA
  ios-testflight        verify gate seal + export + upload, without rebuilding
  ios-release-artifacts alias for ios-testflight

env (read from .env.release.local or shell):
  NVPN_ASC_AUTH_KEY_PATH         App Store Connect API key .p8
  NVPN_ASC_AUTH_KEY_ID           Key ID
  NVPN_ASC_AUTH_KEY_ISSUER_ID    Issuer ID
  NVPN_IOS_TEAM_ID               Apple developer team id (required)
  NVPN_IOS_BUNDLE_ID             App bundle id (default fi.siriusbusiness.nvpn)
  NVPN_IOS_BUILD_NUMBER          positive integer override for the tracked
                                 ios/app-store-build-number
  NVPN_IOS_EXPORT_SIGNING_CERTIFICATE
                                  export signing certificate (default from profile env)
  NVPN_ITMS_TRANSPORTER          iTMSTransporter path
  NVPN_IOS_UPLOAD_TRANSPORT      Transporter delivery method (default HTTP)
  NVPN_IOS_ADHOC_PROVISIONING_PROFILE_UUID
  NVPN_IOS_ADHOC_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID
                                  exact Ad Hoc profiles for ios-release-testing
  NVPN_IOS_FROZEN_DEVICE_UDID    physical device required in those profiles
  NVPN_RELEASE_STAGE_DIR          exact passed release gate for upload actions
EOF
}

require_var NVPN_ASC_AUTH_KEY_PATH
require_var NVPN_ASC_AUTH_KEY_ID
require_var NVPN_ASC_AUTH_KEY_ISSUER_ID

export NVPN_IOS_BUNDLE_ID="$BUNDLE_ID"
export NVPN_IOS_PACKET_TUNNEL_BUNDLE_ID="$PACKET_TUNNEL_BUNDLE_ID"
export NVPN_IOS_APP_GROUP_IDENTIFIER="$APP_GROUP_IDENTIFIER"

run_ios_rust() {
  "$ROOT/tools/run-ios" rust
}

run_ios_xcframework() {
  "$ROOT/tools/run-ios" xcframework
}

run_ios_project() {
  "$ROOT/tools/run-ios" project
}

ensure_profiles() {
  ensure_dir "$DIST_DIR"
  NVPN_IOS_PROFILES_ENV_PATH="$PROVISIONING_ENV" "$HARNESS_ROOT/scripts/ios-profiles" ensure
}

write_export_options() {
  local output="$1"
  local method="$2"
  local app_uuid="$3"
  local tunnel_uuid="$4"
  local internal_only="$5"
  local testflight_internal_only=""
  local testflight_entry=""
  local signing_certificate="${NVPN_IOS_EXPORT_SIGNING_CERTIFICATE:-${NVPN_IOS_CODE_SIGN_IDENTITY:-Apple Distribution}}"
  if bool_is_true "$internal_only"; then
    testflight_internal_only="<true/>"
  else
    testflight_internal_only="<false/>"
  fi
  if [[ "$method" == "app-store-connect" ]]; then
    testflight_entry="  <key>testFlightInternalTestingOnly</key>
  $testflight_internal_only"
  fi
  cat >"$output" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>
  <string>$method</string>
  <key>destination</key>
  <string>export</string>
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
  <key>teamID</key>
  <string>$TEAM_ID</string>
  <key>signingStyle</key>
  <string>manual</string>
  <key>signingCertificate</key>
  <string>$signing_certificate</string>
  <key>uploadSymbols</key>
  <true/>
  <key>uploadBitcode</key>
  <false/>
$testflight_entry
  <key>provisioningProfiles</key>
  <dict>
    <key>$BUNDLE_ID</key>
    <string>$app_uuid</string>
    <key>$PACKET_TUNNEL_BUNDLE_ID</key>
    <string>$tunnel_uuid</string>
  </dict>
</dict>
</plist>
EOF
}

prepare_frozen_revision_args() {
  local app_head app_tree fips_path fips_head fips_tree fips_version
  local expected_team expected_signer fips_metadata source_version
  local NVPN_IOS_RUST_PROFILE="${NVPN_IOS_RUST_PROFILE:-release}"
  [[ "$NVPN_IOS_RUST_PROFILE" == "release" ]] || {
    echo "Frozen iOS archive requires the Release Rust profile." >&2
    return 1
  }
  app_head="$(git -C "$ROOT" rev-parse HEAD)"
  app_tree="$(git -C "$ROOT" rev-parse 'HEAD^{tree}')"
  assert_release_checkout_state \
    "$ROOT" "$app_head" "$app_tree" "frozen iOS archive" \
    || return 1
  pin_exact_release_build_git_sha \
    "$ROOT" "$app_head" "Frozen iOS archive" \
    || return 1
  [[ "$BUNDLE_ID" == "$NVPN_BUILTIN_IOS_BUNDLE_ID" \
    && "$PACKET_TUNNEL_BUNDLE_ID" == "$BUNDLE_ID.PacketTunnel" \
    && "$APP_GROUP_IDENTIFIER" == "group.$BUNDLE_ID.shared" ]] || {
    echo "Frozen iOS archive requires the canonical production identifiers." >&2
    return 1
  }
  source_version="$(package_version "$ROOT")"
  [[ -n "$source_version" \
    && "$NVPN_APP_VERSION_NAME" == "$source_version" ]] || {
    echo "Frozen iOS archive version does not match the tracked source." >&2
    return 1
  }

  fips_path="${NVPN_FIPS_REPO_PATH:-}"
  [[ -n "$fips_path" && (-d "$fips_path/.git" || -f "$fips_path/.git") ]] || {
    echo "Frozen iOS archive requires NVPN_FIPS_REPO_PATH." >&2
    return 1
  }
  fips_head="$(git -C "$fips_path" rev-parse HEAD)"
  fips_tree="$(git -C "$fips_path" rev-parse 'HEAD^{tree}')"
  [[ -z "$(git -C "$fips_path" status --porcelain --untracked-files=all)" ]] || {
    echo "Frozen iOS archive refuses a dirty FIPS checkout." >&2
    return 1
  }
  require_exact_release_fips_revision "$fips_head" || return 1
  fips_version="$(
    awk '
      $0 == "[package]" { package = 1; next }
      package && /^\[/ { exit }
      package && /^version = "/ {
        value = $0
        sub(/^version = "/, "", value)
        sub(/".*$/, "", value)
        print value
        exit
      }
    ' "$fips_path/crates/fips-core/Cargo.toml"
  )"
  [[ "$fips_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]] || {
    echo "Frozen iOS archive could not derive the FIPS version." >&2
    return 1
  }
  if [[ -n "${NVPN_EXPECTED_FIPS_VERSION:-}" \
    && "$NVPN_EXPECTED_FIPS_VERSION" != "$fips_version" ]]
  then
    echo "Frozen iOS archive FIPS version does not match the required version." >&2
    return 1
  fi
  export NVPN_EXPECTED_FIPS_VERSION="$fips_version"

  expected_team="${NVPN_EXPECTED_IOS_DISTRIBUTION_TEAM_ID:-}"
  [[ "$expected_team" =~ ^[A-Z0-9]{10}$ && "$TEAM_ID" == "$expected_team" ]] || {
    echo "Frozen iOS archive requires the pinned company distribution team." >&2
    return 1
  }
  expected_signer="$(
    printf '%s' "${NVPN_EXPECTED_IOS_DISTRIBUTION_CERT_SHA256:-}" \
      | tr -d ':[:space:]' \
      | tr '[:upper:]' '[:lower:]'
  )"
  [[ "$expected_signer" =~ ^[0-9a-f]{64}$ ]] || {
    echo "Frozen iOS archive requires the pinned distribution certificate." >&2
    return 1
  }
  fips_metadata="${NVPN_IOS_FIPS_METADATA_RECEIPT:-$ROOT/artifacts/mobile-ios/fips-linkage.json}"
  FROZEN_REVISION_ARGS=(
    --source-root "$ROOT"
    --fips-root "$fips_path"
    --fips-metadata "$fips_metadata"
    --app-head "$app_head"
    --app-tree "$app_tree"
    --fips-head "$fips_head"
    --fips-tree "$fips_tree"
    --fips-version "$fips_version"
    --rust-profile "$NVPN_IOS_RUST_PROFILE"
    --version "$NVPN_APP_VERSION_NAME"
    --build "$NVPN_IOS_BUILD_NUMBER"
    --app-bundle-id "$BUNDLE_ID"
    --tunnel-bundle-id "$PACKET_TUNNEL_BUNDLE_ID"
    --app-group-id "$APP_GROUP_IDENTIFIER"
    --team-id "$expected_team"
    --signer-sha "$expected_signer"
  )
}

validate_frozen_archive() {
  prepare_frozen_revision_args
  python3 "$FROZEN_TOOL" validate-archive \
    --archive "$ARCHIVE_PATH" \
    --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
    "${FROZEN_REVISION_ARGS[@]}"
}

write_frozen_archive_receipt() {
  prepare_frozen_revision_args
  python3 "$FROZEN_TOOL" freeze \
    --archive "$ARCHIVE_PATH" \
    --receipt "$FROZEN_ARCHIVE_RECEIPT" \
    "${FROZEN_REVISION_ARGS[@]}"
}

restore_generated_ios_project() {
  git -C "$ROOT" show \
    "$NVPN_BUILD_GIT_SHA:ios/NostrVpnIos.xcodeproj/project.pbxproj" \
    >"$PROJECT/project.pbxproj"
}

quarantine_stale_frozen_state() {
  local quarantine
  quarantine="$(
    mktemp -d "${TMPDIR:-/tmp}/nvpn-ios-stale-state.XXXXXX"
  )" || return 1
  chmod 700 "$quarantine"
  if [[ -e "$ARCHIVE_PATH" ]]; then
    mv "$ARCHIVE_PATH" "$quarantine/NostrVpnIos.xcarchive" || return 1
  fi
  if [[ -e "$FROZEN_DIR" ]]; then
    mv "$FROZEN_DIR" "$quarantine/frozen" || return 1
  fi
  echo "Quarantined stale generated iOS archive state for recovery."
}

run_ios_archive() {
  local NVPN_IOS_RUST_PROFILE="release"
  export NVPN_IOS_RUST_PROFILE
  prepare_frozen_revision_args
  if [[ -e "$ARCHIVE_PATH" || -e "$FROZEN_DIR" ]]; then
    if [[ -d "$ARCHIVE_PATH" && -f "$FROZEN_ARCHIVE_RECEIPT" ]] \
      && validate_frozen_archive
    then
      echo "Reusing the exact verified frozen iOS archive."
      return
    fi
    quarantine_stale_frozen_state
  fi
  ensure_profiles
  ensure_dir "$DIST_DIR"

  run_ios_rust
  run_ios_xcframework
  run_ios_project

  # shellcheck disable=SC1090
  source "$PROVISIONING_ENV"
  : "${NVPN_IOS_CODE_SIGN_IDENTITY:?code signing identity not set}"
  : "${NVPN_IOS_PROVISIONING_PROFILE_UUID:?profile uuid not set}"
  : "${NVPN_IOS_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID:?packet tunnel profile uuid not set}"

  if ! xcodebuild \
    -project "$PROJECT" \
    -scheme "$SCHEME" \
    -configuration "$CONFIGURATION" \
    -destination "generic/platform=iOS" \
    -archivePath "$ARCHIVE_PATH" \
    -allowProvisioningUpdates \
    DEVELOPMENT_TEAM="$TEAM_ID" \
    NVPN_IOS_CODE_SIGN_IDENTITY="$NVPN_IOS_CODE_SIGN_IDENTITY" \
    NVPN_IOS_PROVISIONING_PROFILE_UUID="$NVPN_IOS_PROVISIONING_PROFILE_UUID" \
    NVPN_IOS_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID="$NVPN_IOS_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID" \
    NVPN_BUILD_GIT_SHA="$NVPN_BUILD_GIT_SHA" \
    NVPN_BUILD_TIMESTAMP_UTC="$NVPN_BUILD_TIMESTAMP_UTC" \
    archive
  then
    restore_generated_ios_project || true
    return 1
  fi
  restore_generated_ios_project
  write_frozen_archive_receipt
  echo "Frozen iOS archive created once: $ARCHIVE_PATH"
}

run_export_archive() {
  local export_dir="$1" options="$2"
  ensure_dir "$(dirname "$export_dir")"
  rm -rf "$export_dir"
  mkdir -p "$export_dir"
  xcodebuild \
    -exportArchive \
    -archivePath "$ARCHIVE_PATH" \
    -exportPath "$export_dir" \
    -exportOptionsPlist "$options" \
    -allowProvisioningUpdates
}

exact_ipa_path() {
  local export_dir="$1"
  local -a matches=()
  while IFS= read -r path; do
    [[ -n "$path" ]] && matches+=("$path")
  done < <(find "$export_dir" -maxdepth 1 -name '*.ipa' -type f | sort)
  [[ "${#matches[@]}" -eq 1 ]] || {
    echo "Expected exactly one IPA in $export_dir; found ${#matches[@]}." >&2
    return 1
  }
  printf '%s\n' "${matches[0]}"
}

unpack_ipa() {
  local ipa="$1" destination="$2"
  local -a matches=()
  rm -rf "$destination"
  mkdir -p "$destination"
  ditto -x -k "$ipa" "$destination"
  while IFS= read -r path; do
    [[ -n "$path" ]] && matches+=("$path")
  done < <(
    find "$destination/Payload" -maxdepth 1 -name '*.app' -type d | sort
  )
  [[ "${#matches[@]}" -eq 1 ]] || {
    echo "Expected one app in exported IPA; found ${#matches[@]}." >&2
    return 1
  }
  printf '%s\n' "${matches[0]}"
}

frozen_gate_arguments() {
  FROZEN_GATE_ARGS=(
    --required-gate wireguard-exit-and-five-dns-policies
    --required-gate background-foreground-and-rapid-start-stop
    --required-gate wifi-radio-off-on-recovery
    --required-gate bidirectional-mobile-qr-and-manual-join
    --required-gate desktop-mobile-manual-join
  )
}

validate_frozen_gate_seal() {
  frozen_gate_arguments
  python3 "$FROZEN_TOOL" validate-gate-seal \
    --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
    --adhoc-receipt "$FROZEN_ADHOC_RECEIPT" \
    --sealed-mobile-receipt "$FROZEN_MOBILE_RECEIPT" \
    --mobile-join-ios-variant-receipt \
      "$FROZEN_MOBILE_JOIN_IOS_VARIANT_RECEIPT" \
    --mobile-join-receipt "$FROZEN_MOBILE_JOIN_RECEIPT" \
    --mobile-wg-receipt "$FROZEN_MOBILE_WG_RECEIPT" \
    --mobile-underlay-receipt "$FROZEN_MOBILE_UNDERLAY_RECEIPT" \
    --desktop-mobile-join-receipt "$FROZEN_DESKTOP_MOBILE_JOIN_RECEIPT" \
    --gate-seal "$FROZEN_GATE_SEAL" \
    "${FROZEN_GATE_ARGS[@]}"
}

run_ios_release_testing_export() {
  local app_uuid="${NVPN_IOS_ADHOC_PROVISIONING_PROFILE_UUID:-}"
  local tunnel_uuid="${NVPN_IOS_ADHOC_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID:-}"
  local device_udid="${NVPN_IOS_FROZEN_DEVICE_UDID:-}"
  local options="$FROZEN_DIR/ReleaseTestingExportOptions.plist"
  local ipa app
  : "${app_uuid:?NVPN_IOS_ADHOC_PROVISIONING_PROFILE_UUID is required}"
  : "${tunnel_uuid:?NVPN_IOS_ADHOC_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID is required}"
  : "${device_udid:?NVPN_IOS_FROZEN_DEVICE_UDID is required}"
  validate_frozen_archive
  if [[ -f "$FROZEN_ADHOC_RECEIPT" \
    || -d "$FROZEN_ADHOC_EXPORT_DIR" \
    || -d "$FROZEN_ADHOC_UNPACK_DIR" ]]
  then
    [[ -f "$FROZEN_ADHOC_RECEIPT" \
      && -d "$FROZEN_ADHOC_EXPORT_DIR" \
      && -d "$FROZEN_ADHOC_UNPACK_DIR" ]] || {
      echo "Frozen release-testing export state is incomplete; refusing to replace it." >&2
      return 1
    }
    ipa="$(exact_ipa_path "$FROZEN_ADHOC_EXPORT_DIR")"
    app="$(unpack_ipa "$ipa" "$FROZEN_ADHOC_UNPACK_DIR")"
    prepare_frozen_revision_args
    python3 "$FROZEN_TOOL" validate-export \
      --archive "$ARCHIVE_PATH" \
      --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
      --app "$app" \
      --ipa "$ipa" \
      --output "$FROZEN_ADHOC_RECEIPT" \
      --distribution release-testing \
      --device-udid "$device_udid" \
      "${FROZEN_REVISION_ARGS[@]}"
    echo "Reusing the exact verified release-testing export."
    return
  fi
  ensure_dir "$FROZEN_DIR"
  write_export_options \
    "$options" \
    release-testing \
    "$app_uuid" \
    "$tunnel_uuid" \
    false
  run_export_archive "$FROZEN_ADHOC_EXPORT_DIR" "$options"
  ipa="$(exact_ipa_path "$FROZEN_ADHOC_EXPORT_DIR")"
  app="$(unpack_ipa "$ipa" "$FROZEN_ADHOC_UNPACK_DIR")"
  prepare_frozen_revision_args
  python3 "$FROZEN_TOOL" validate-export \
    --archive "$ARCHIVE_PATH" \
    --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
    --app "$app" \
    --ipa "$ipa" \
    --output "$FROZEN_ADHOC_RECEIPT" \
    --distribution release-testing \
    --device-udid "$device_udid" \
    "${FROZEN_REVISION_ARGS[@]}"
  echo "Release-testing app exported from the frozen archive: $app"
}

run_ios_export() {
  local ipa app
  validate_frozen_archive
  validate_frozen_gate_seal
  ensure_profiles
  # shellcheck disable=SC1090
  source "$PROVISIONING_ENV"
  : "${NVPN_IOS_PROVISIONING_PROFILE_UUID:?profile uuid not set}"
  : "${NVPN_IOS_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID:?packet tunnel profile uuid not set}"
  write_export_options \
    "$EXPORT_OPTIONS" \
    app-store-connect \
    "$NVPN_IOS_PROVISIONING_PROFILE_UUID" \
    "$NVPN_IOS_PACKET_TUNNEL_PROVISIONING_PROFILE_UUID" \
    "$IOS_INTERNAL_ONLY"
  run_export_archive "$EXPORT_DIR" "$EXPORT_OPTIONS"
  ipa="$(exact_ipa_path "$EXPORT_DIR")"
  app="$(unpack_ipa "$ipa" "$FROZEN_APPSTORE_UNPACK_DIR")"
  prepare_frozen_revision_args
  python3 "$FROZEN_TOOL" validate-export \
    --archive "$ARCHIVE_PATH" \
    --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
    --app "$app" \
    --ipa "$ipa" \
    --output "$FROZEN_APPSTORE_RECEIPT" \
    --distribution app-store-connect \
    "${FROZEN_REVISION_ARGS[@]}"
}

IOS_UPLOAD_IPA=""
IOS_UPLOAD_TRANSPORTER=""

prepare_ios_upload() {
  local ipa app expected_sha actual_sha
  local transporter="${NVPN_ITMS_TRANSPORTER:-/Applications/Transporter.app/Contents/itms/bin/iTMSTransporter}"
  validate_frozen_archive
  validate_frozen_gate_seal
  ipa="$(exact_ipa_path "$EXPORT_DIR")"
  app="$(unpack_ipa "$ipa" "$FROZEN_APPSTORE_UNPACK_DIR")"
  prepare_frozen_revision_args
  python3 "$FROZEN_TOOL" validate-export \
    --archive "$ARCHIVE_PATH" \
    --archive-receipt "$FROZEN_ARCHIVE_RECEIPT" \
    --app "$app" \
    --ipa "$ipa" \
    --output "$FROZEN_APPSTORE_RECEIPT" \
    --distribution app-store-connect \
    "${FROZEN_REVISION_ARGS[@]}"
  expected_sha="$(
    python3 - "$FROZEN_APPSTORE_RECEIPT" "$ipa" <<'PY'
import json
import os
import sys

receipt = json.load(open(sys.argv[1], encoding="utf-8"))
if receipt.get("distribution") != "app-store-connect":
    raise SystemExit("wrong App Store export receipt distribution")
expected_path = receipt.get("ipaPathSha256")
actual_path = __import__("hashlib").sha256(os.path.realpath(sys.argv[2]).encode()).hexdigest()
if expected_path != actual_path:
    raise SystemExit("App Store export receipt points at a different IPA")
print(receipt.get("ipaSha256", ""))
PY
  )"
  actual_sha="$(shasum -a 256 "$ipa" | awk '{print tolower($1)}')"
  [[ "$expected_sha" =~ ^[0-9a-f]{64}$ && "$actual_sha" == "$expected_sha" ]] || {
    echo "App Store IPA changed after frozen-archive verification." >&2
    return 1
  }
  if [[ ! -x "$transporter" ]]; then
    echo "iTMSTransporter not found: $transporter" >&2
    echo "Install Apple's Transporter app or set NVPN_ITMS_TRANSPORTER." >&2
    exit 1
  fi
  IOS_UPLOAD_IPA="$ipa"
  IOS_UPLOAD_TRANSPORTER="$transporter"
}

run_ios_upload() {
  prepare_ios_upload
  local ipa="$IOS_UPLOAD_IPA"
  local transporter="$IOS_UPLOAD_TRANSPORTER"
  echo "Uploading $ipa to App Store Connect..."
  "$transporter" \
    -m upload \
    -assetFile "$ipa" \
    -apiKey "$NVPN_ASC_AUTH_KEY_ID" \
    -apiIssuer "$NVPN_ASC_AUTH_KEY_ISSUER_ID" \
    -t "$IOS_UPLOAD_TRANSPORT" \
    -v informational \
    -throughput
  echo "Upload submitted. Build will appear in App Store Connect once Apple"
  echo "finishes processing (typically 5-15 minutes)."
}

run_ios_attach_internal() {
  # Apple's altool --upload-app drops the IPA into App Store Connect but does
  # NOT attach the resulting build to any TestFlight tester group. Without
  # this the build sits in "Builds" forever and never appears in the
  # internal-testers' TestFlight app — the entire reason we ran the upload.
  # Polls for this release's exact build number, then attaches it to the
  # internal-testers group.
  "$HARNESS_ROOT/scripts/testflight-internal" put
}

run_ios_testflight() {
  validate_frozen_archive
  validate_frozen_gate_seal
  run_ios_export
  run_ios_upload
  run_ios_attach_internal
}

case "${1:-}" in
  ios-rust) run_ios_rust ;;
  ios-xcframework) run_ios_xcframework ;;
  ios-project) run_ios_project ;;
  ios-archive) run_ios_archive ;;
  ios-release-testing) run_ios_release_testing_export ;;
  ios-export) run_ios_export ;;
  ios-upload-preflight)
    require_release_mutation_gate "$HARNESS_ROOT"
    prepare_ios_upload
    echo "Exact App Store upload preflight passed."
    ;;
  ios-upload)
    require_release_mutation_gate "$HARNESS_ROOT"
    run_ios_upload
    ;;
  ios-attach-internal)
    require_release_mutation_gate "$HARNESS_ROOT"
    run_ios_attach_internal
    ;;
  ios-testflight|ios-release-artifacts)
    require_release_mutation_gate "$HARNESS_ROOT"
    run_ios_testflight
    ;;
  -h|--help|help|"") usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
