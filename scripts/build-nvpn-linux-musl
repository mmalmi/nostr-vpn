#!/usr/bin/env bash
set -euo pipefail

TARGET=${1:-${NVPN_LINUX_MUSL_TARGET:-x86_64-unknown-linux-musl}}
WORKSPACE=$(git rev-parse --show-toplevel)
BUILD_ROOT=${NVPN_LINUX_MUSL_BUILD_ROOT:-${TMPDIR:-/tmp}}
TARGET_DIR=${NVPN_LINUX_MUSL_TARGET_DIR:-$WORKSPACE/target}
WORK_DIR=$(mktemp -d "$BUILD_ROOT/nvpn-linux-musl.XXXXXX")
FIPS_REPO_PATH=${NVPN_FIPS_REPO_PATH:-}
NOSTR_PUBSUB_REPO_PATH=${NVPN_NOSTR_PUBSUB_REPO_PATH:-}
CASHU_SERVICE_REPO_PATH=${NVPN_CASHU_SERVICE_REPO_PATH:-}
CDK_SPILMAN_REPO_PATH=${NVPN_CDK_SPILMAN_REPO_PATH:-${NVPN_CASHU_SPILMAN_REPO_PATH:-}}
DOCKER_ENV=()

if [[ ${NVPN_LINUX_MUSL_STRIP:-0} == 1 ]]; then
  DOCKER_ENV+=(-e NVPN_LINUX_MUSL_STRIP=1)
fi
if [[ ${NVPN_LINUX_MUSL_NO_DEFAULT_FEATURES:-0} == 1 ]]; then
  DOCKER_ENV+=(-e NVPN_LINUX_MUSL_NO_DEFAULT_FEATURES=1)
fi

source "$WORKSPACE/scripts/release_common.sh"
enable_deterministic_build_env "$WORKSPACE"

case "$TARGET" in
  i686-unknown-linux-musl)
    DEFAULT_IMAGE=messense/rust-musl-cross:i686-musl
    BINDGEN_INCLUDE=/usr/local/musl/i686-unknown-linux-musl/include
    TARGET_LINKER=i686-unknown-linux-musl-gcc
    ;;
  x86_64-unknown-linux-musl)
    DEFAULT_IMAGE=messense/rust-musl-cross:x86_64-musl
    BINDGEN_INCLUDE=/usr/local/musl/x86_64-unknown-linux-musl/include
    TARGET_LINKER=x86_64-unknown-linux-musl-gcc
    ;;
  aarch64-unknown-linux-musl)
    DEFAULT_IMAGE=messense/rust-musl-cross:aarch64-musl
    BINDGEN_INCLUDE=/usr/local/musl/aarch64-unknown-linux-musl/include
    TARGET_LINKER=aarch64-unknown-linux-musl-gcc
    ;;
  arm-unknown-linux-musleabihf)
    DEFAULT_IMAGE=messense/rust-musl-cross:arm-musleabihf
    BINDGEN_INCLUDE=/usr/local/musl/arm-unknown-linux-musleabihf/include
    TARGET_LINKER=arm-unknown-linux-musleabihf-gcc
    ;;
  *)
    echo "unsupported Linux musl target: $TARGET" >&2
    exit 1
    ;;
esac

IMAGE=${NVPN_LINUX_MUSL_IMAGE:-$DEFAULT_IMAGE}
PUBLIC_DOCKER_CONFIG=""
if [[ "$IMAGE" == "$DEFAULT_IMAGE" ]]; then
  PUBLIC_DOCKER_CONFIG="$WORK_DIR/.docker-public"
  mkdir -p "$PUBLIC_DOCKER_CONFIG"
fi

run_builder_docker() {
  if [[ -n "$PUBLIC_DOCKER_CONFIG" ]]; then
    docker --config "$PUBLIC_DOCKER_CONFIG" "$@"
  else
    docker "$@"
  fi
}

BINDGEN_ENV_NAME="BINDGEN_EXTRA_CLANG_ARGS_$(printf '%s' "$TARGET" | tr '-' '_')"
LINKER_ENV_NAME="CARGO_TARGET_$(printf '%s' "$TARGET" | tr '[:lower:]-' '[:upper:]_')_LINKER"
DOCKER_ENV+=(-e "$BINDGEN_ENV_NAME=-I$BINDGEN_INCLUDE")
if [[ -n "$TARGET_LINKER" ]]; then
  DOCKER_ENV+=(-e "$LINKER_ENV_NAME=$TARGET_LINKER")
fi

cleanup() {
  if [[ ${NVPN_LINUX_MUSL_KEEP_WORK:-0} != 1 ]]; then
    rm -rf "$WORK_DIR"
  fi
}
trap cleanup EXIT

git -C "$WORKSPACE" archive --format=tar HEAD | tar -x -C "$WORK_DIR"
mkdir -p "$TARGET_DIR"

if [[ -n "$FIPS_REPO_PATH" ]]; then
  FIPS_PATCH_DIR="$WORK_DIR/.fips-patch"
  fips_head="$(git -C "$FIPS_REPO_PATH" rev-parse HEAD)"
  git clone --no-hardlinks --quiet "$FIPS_REPO_PATH" "$FIPS_PATCH_DIR"
  git -C "$FIPS_PATCH_DIR" checkout --detach --quiet "$fips_head"
  git -C "$FIPS_PATCH_DIR" clean -ffd >/dev/null

  if [[ -f "$FIPS_PATCH_DIR/crates/fips-endpoint/Cargo.toml" ]]; then
    DOCKER_ENV+=(-e NVPN_FIPS_ENDPOINT_PATCH_PATH=/home/rust/src/.fips-patch/crates/fips-endpoint)
    if [[ -f "$FIPS_PATCH_DIR/crates/fips-core/Cargo.toml" ]]; then
      DOCKER_ENV+=(-e NVPN_FIPS_CORE_PATCH_PATH=/home/rust/src/.fips-patch/crates/fips-core)
    fi
    if [[ -f "$FIPS_PATCH_DIR/crates/fips-identity/Cargo.toml" ]]; then
      DOCKER_ENV+=(-e NVPN_FIPS_IDENTITY_PATCH_PATH=/home/rust/src/.fips-patch/crates/fips-identity)
    fi
  elif [[ -f "$FIPS_PATCH_DIR/Cargo.toml" ]]; then
    DOCKER_ENV+=(-e NVPN_FIPS_ENDPOINT_PATCH_PATH=/home/rust/src/.fips-patch)
  else
    echo "NVPN_FIPS_REPO_PATH does not contain fips-endpoint sources" >&2
    exit 1
  fi

  NVPN_LOCAL_FIPS_CORE_PATH=".fips-patch/crates/fips-core" \
  NVPN_LOCAL_FIPS_ENDPOINT_PATH=".fips-patch/crates/fips-endpoint" \
  NVPN_LOCAL_FIPS_IDENTITY_PATH=".fips-patch/crates/fips-identity" \
    perl -0pi -e '
      s#(fips-core = \{[^}\n]*path = ")[^"]*(")#$1$ENV{NVPN_LOCAL_FIPS_CORE_PATH}$2#;
      s#(fips-endpoint = \{[^}\n]*path = ")[^"]*(")#$1$ENV{NVPN_LOCAL_FIPS_ENDPOINT_PATH}$2#;
      s#(fips-identity = \{[^}\n]*path = ")[^"]*(")#$1$ENV{NVPN_LOCAL_FIPS_IDENTITY_PATH}$2#;
    ' "$WORK_DIR/Cargo.toml"
fi

if [[ -n "$NOSTR_PUBSUB_REPO_PATH" ]]; then
  NOSTR_PUBSUB_PATCH_DIR="$WORK_DIR/.nostr-pubsub-patch"
  nostr_pubsub_head="$(git -C "$NOSTR_PUBSUB_REPO_PATH" rev-parse HEAD)"
  git clone --no-hardlinks --quiet "$NOSTR_PUBSUB_REPO_PATH" "$NOSTR_PUBSUB_PATCH_DIR"
  git -C "$NOSTR_PUBSUB_PATCH_DIR" checkout --detach --quiet "$nostr_pubsub_head"
  git -C "$NOSTR_PUBSUB_PATCH_DIR" clean -ffd >/dev/null
  if [[ ! -f "$NOSTR_PUBSUB_PATCH_DIR/crates/nostr-pubsub-fips/Cargo.toml" ]]; then
    echo "NVPN_NOSTR_PUBSUB_REPO_PATH does not contain nostr-pubsub-fips sources" >&2
    exit 1
  fi
  DOCKER_ENV+=(
    -e NVPN_NOSTR_PUBSUB_PATCH_PATH=/home/rust/src/.nostr-pubsub-patch/crates/nostr-pubsub
    -e NVPN_NOSTR_PUBSUB_FIPS_PATCH_PATH=/home/rust/src/.nostr-pubsub-patch/crates/nostr-pubsub-fips
    -e NVPN_NOSTR_PUBSUB_SOCIAL_GRAPH_PATCH_PATH=/home/rust/src/.nostr-pubsub-patch/crates/nostr-pubsub-social-graph
  )
fi

if [[ -n "$CASHU_SERVICE_REPO_PATH" ]]; then
  CASHU_PATCH_DIR="$WORK_DIR/.cashu-service-patch"
  mkdir -p "$CASHU_PATCH_DIR"
  git -C "$CASHU_SERVICE_REPO_PATH" archive --format=tar HEAD | tar -x -C "$CASHU_PATCH_DIR"
  if [[ ! -f "$CASHU_PATCH_DIR/crates/cashu-service/Cargo.toml" ]]; then
    echo "NVPN_CASHU_SERVICE_REPO_PATH does not contain cashu-service sources" >&2
    exit 1
  fi
  NVPN_LOCAL_CASHU_SERVICE_PATH=".cashu-service-patch/crates/cashu-service" \
    perl -0pi -e '
      s#cashu-service = \{ version = "([^"]+)"(?:, path = "[^"]*")?([^}]*) \}#cashu-service = { version = "$1", path = "$ENV{NVPN_LOCAL_CASHU_SERVICE_PATH}"$2 }#;
    ' "$WORK_DIR/Cargo.toml"
fi

if [[ -n "$CDK_SPILMAN_REPO_PATH" ]]; then
  CDK_SPILMAN_PATCH_DIR="$WORK_DIR/cashu_spilman_channels"
  mkdir -p "$CDK_SPILMAN_PATCH_DIR"
  git -C "$CDK_SPILMAN_REPO_PATH" archive --format=tar HEAD | tar -x -C "$CDK_SPILMAN_PATCH_DIR"
  if [[ ! -f "$CDK_SPILMAN_PATCH_DIR/crates/cdk-spilman/Cargo.toml" ]]; then
    echo "NVPN_CDK_SPILMAN_REPO_PATH does not contain cdk-spilman sources" >&2
    exit 1
  fi
fi

perl -0pi -e 's#exclude = \["linux"\]#exclude = ["linux", ".fips-patch", ".nostr-pubsub-patch", ".cashu-service-patch", "cashu_spilman_channels"]#' \
  "$WORK_DIR/Cargo.toml"

mkdir -p "$TARGET_DIR/$TARGET/release"
rm -f "$TARGET_DIR/$TARGET/release/nvpn"
run_builder_docker run --rm -i \
  -u "$(id -u):$(id -g)" \
  -v "$WORK_DIR":/home/rust/src \
  -v "$TARGET_DIR":/home/rust/output \
  -e CARGO_HOME=/home/rust/src/.cargo-docker \
  -e HOME=/home/rust/src \
  -e SOURCE_DATE_EPOCH \
  -e CARGO_INCREMENTAL \
  -e ZERO_AR_DATE \
  -e LC_ALL \
  -e TZ \
  "${DOCKER_ENV[@]}" \
  "$IMAGE" \
  bash -se -- "$TARGET" <<'CONTAINER'
set -euo pipefail

TARGET=$1
cd /home/rust/src
# Rust dependency metadata must remain on the container's native filesystem.
# Docker Desktop bind mounts can expose a just-renamed rmeta file before its
# contents are readable by another parallel rustc process. Only copy the
# completed binary through the host bind mount.
export CARGO_TARGET_DIR=/tmp/nvpn-target
OUTPUT_ROOT=/home/rust/output

cargo_config_args=()
cargo_lock_args=(--locked)
if [[ -n ${NVPN_NOSTR_PUBSUB_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nostr-pubsub.path=\"${NVPN_NOSTR_PUBSUB_PATCH_PATH}\"")
  cargo_lock_args=()
fi
if [[ -n ${NVPN_FIPS_ENDPOINT_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nvpn-fips-endpoint.path=\"${NVPN_FIPS_ENDPOINT_PATCH_PATH}\"")
  cargo_lock_args=()
fi
if [[ -n ${NVPN_FIPS_CORE_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nvpn-fips-core.path=\"${NVPN_FIPS_CORE_PATCH_PATH}\"")
  cargo_lock_args=()
fi
if [[ -n ${NVPN_FIPS_IDENTITY_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nvpn-fips-identity.path=\"${NVPN_FIPS_IDENTITY_PATCH_PATH}\"")
  cargo_lock_args=()
fi
if [[ -n ${NVPN_NOSTR_PUBSUB_FIPS_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nostr-pubsub-fips.path=\"${NVPN_NOSTR_PUBSUB_FIPS_PATCH_PATH}\"")
  cargo_lock_args=()
fi
if [[ -n ${NVPN_NOSTR_PUBSUB_SOCIAL_GRAPH_PATCH_PATH:-} ]]; then
  cargo_config_args+=(--config "patch.crates-io.nostr-pubsub-social-graph.path=\"${NVPN_NOSTR_PUBSUB_SOCIAL_GRAPH_PATCH_PATH}\"")
  cargo_lock_args=()
fi

if [[ -n ${NVPN_NOSTR_PUBSUB_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nostr-pubsub
fi
if [[ -n ${NVPN_FIPS_ENDPOINT_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nvpn-fips-endpoint
fi
if [[ -n ${NVPN_FIPS_CORE_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nvpn-fips-core
fi
if [[ -n ${NVPN_FIPS_IDENTITY_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nvpn-fips-identity
fi
if [[ -n ${NVPN_NOSTR_PUBSUB_FIPS_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nostr-pubsub-fips
fi
if [[ -n ${NVPN_NOSTR_PUBSUB_SOCIAL_GRAPH_PATCH_PATH:-} ]]; then
  cargo "${cargo_config_args[@]}" update -p nostr-pubsub-social-graph
fi

cargo "${cargo_config_args[@]}" fetch "${cargo_lock_args[@]}" --target "$TARGET"

rustables_version=$(python3 <<'PY'
from pathlib import Path
import re

blocks = Path("Cargo.lock").read_text().split("[[package]]")
versions = []
for block in blocks:
    if not re.search(r'^name = "rustables"$', block, re.MULTILINE):
        continue
    match = re.search(r'^version = "([^"]+)"$', block, re.MULTILINE)
    if match:
        versions.append(match.group(1))
if len(versions) != 1:
    raise SystemExit(f"expected exactly one rustables package in Cargo.lock, found {len(versions)}")
print(versions[0])
PY
)
mkdir -p vendor
rustables_vendor="vendor/rustables-${rustables_version}"
rm -rf "$rustables_vendor"
rustables_fetch_dir=$(mktemp -d /tmp/nvpn-rustables-fetch.XXXXXX)
cat >"$rustables_fetch_dir/Cargo.toml" <<EOF
[package]
name = "nvpn-rustables-fetch"
version = "0.0.0"
edition = "2021"

[lib]
path = "lib.rs"

[dependencies]
rustables = "=${rustables_version}"
EOF
: >"$rustables_fetch_dir/lib.rs"
cargo fetch --manifest-path "$rustables_fetch_dir/Cargo.toml" --target "$TARGET"
rm -rf "$rustables_fetch_dir"
rustables_crate=$(find "${CARGO_HOME:-/root/.cargo}/registry/cache" -maxdepth 3 \
  -type f -name "rustables-${rustables_version}.crate" -print -quit)
if [[ -z "$rustables_crate" ]]; then
  echo "rustables ${rustables_version} was not found after its targeted cargo fetch" >&2
  exit 1
fi
tar -xzf "$rustables_crate" -C vendor
if [[ ! -f "$rustables_vendor/Cargo.toml" ]]; then
  echo "rustables ${rustables_version} archive did not contain the expected crate" >&2
  exit 1
fi

rustables_patch_line="rustables = { path = \"$rustables_vendor\" }"
if ! grep -Fq "$rustables_patch_line" Cargo.toml; then
  python3 - "$rustables_patch_line" <<'PATCH'
from pathlib import Path
import sys

path = Path("Cargo.toml")
patch_line = sys.argv[1]
text = path.read_text()
if "[patch.crates-io]\n" in text:
    text = text.replace("[patch.crates-io]\n", f"[patch.crates-io]\n{patch_line}\n", 1)
else:
    text += f"\n[patch.crates-io]\n{patch_line}\n"
path.write_text(text)
PATCH
  cargo "${cargo_config_args[@]}" update -p rustables
fi

if ! grep -q 'NFTA_CHAIN_FLAGS' "$rustables_vendor/build.rs"; then
  python3 - "$rustables_vendor/build.rs" <<'PATCH'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
old = '    let s = bindings.to_string().replace(" ; ", ";\\n");\n    let s = reformat_units(&s);\n'
new = '''    let mut s = bindings.to_string().replace(" ; ", ";\\n");
    if !s.contains("NFTA_CHAIN_FLAGS") {
        s = s.replace(
            "pub const __NFTA_CHAIN_MAX: nft_chain_attributes = 10;\\n",
            concat!(
                "pub const NFTA_CHAIN_FLAGS: nft_chain_attributes = 10;\\n",
                "pub const NFTA_CHAIN_ID: nft_chain_attributes = 11;\\n",
                "pub const NFTA_CHAIN_USERDATA: nft_chain_attributes = 12;\\n",
                "pub const __NFTA_CHAIN_MAX: nft_chain_attributes = 13;\\n",
            ),
        );
    }
    let s = reformat_units(&s);
'''
if old not in text:
    raise SystemExit("expected rustables build.rs binding line was not found")
path.write_text(text.replace(old, new))
PATCH
fi

cargo_feature_args=()
if [[ ${NVPN_LINUX_MUSL_NO_DEFAULT_FEATURES:-0} == 1 ]]; then
  cargo_feature_args+=(--no-default-features)
fi
cargo "${cargo_config_args[@]}" build "${cargo_lock_args[@]}" \
  "${cargo_feature_args[@]}" -p nvpn --bin nvpn --release --target "$TARGET"
if [[ ${NVPN_LINUX_MUSL_STRIP:-0} == 1 ]]; then
  "${TARGET}-strip" "$CARGO_TARGET_DIR/$TARGET/release/nvpn"
fi
install -D -m 0755 \
  "$CARGO_TARGET_DIR/$TARGET/release/nvpn" \
  "$OUTPUT_ROOT/$TARGET/release/nvpn"
CONTAINER

BIN="$TARGET_DIR/$TARGET/release/nvpn"
if [[ ! -x "$BIN" ]]; then
  echo "expected output binary missing: $BIN" >&2
  exit 1
fi

if [[ -n ${NVPN_SMOKE_HOST:-} ]]; then
  REMOTE_PATH=${NVPN_SMOKE_PATH:-/tmp/nvpn-musl-smoke}
  scp "$BIN" "$NVPN_SMOKE_HOST:$REMOTE_PATH"
  ssh "$NVPN_SMOKE_HOST" "chmod +x '$REMOTE_PATH' && '$REMOTE_PATH' --help >/dev/null"
fi

printf '%s\n' "$BIN"
