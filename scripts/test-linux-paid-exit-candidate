#!/usr/bin/env python3
"""Exercise the real FIPS candidate DNS/HTTPS path in a disposable Linux container.

Usage: test-linux-paid-exit-candidate TEST_BINARY LOCAL_E2E_IMAGE
The image needs Python 3, iproute2, iptables and a compatible Linux runtime.
"""
import fcntl
import os
from pathlib import Path
import struct
import subprocess
import sys

def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)

def tun(name, address):
    fd = os.open("/dev/net/tun", os.O_RDWR | os.O_NONBLOCK)
    fcntl.ioctl(fd, 0x400454CA, struct.pack("16sH", name.encode(), 0x1001))
    run("ip", "addr", "add", address, "dev", name)
    run("ip", "link", "set", name, "up")
    return fd

def main():
    if sys.argv[1:] == ["--seller"] and Path("/.dockerenv").exists():
        fd = tun("nvpnup", "10.44.1.1/32")
        run("ip", "route", "add", "10.44.1.2/32", "dev", "nvpnup")
        run("iptables", "-t", "nat", "-A", "POSTROUTING", "-s", "10.44.1.2/32",
            "-o", "eth0", "-j", "MASQUERADE")
        os.environ["NVPN_FIXTURE_SELLER_FD"] = str(fd)
        run("unshare", "--net", "python3", "/fixture", "--buyer", pass_fds=(fd,))
    elif sys.argv[1:] == ["--buyer"] and Path("/.dockerenv").exists():
        run("ip", "link", "set", "lo", "up")
        fd = tun("nvpnprobe", "10.44.1.2/32")
        run("ip", "route", "add", "default", "dev", "nvpnprobe")
        os.environ["NVPN_FIXTURE_BUYER_FD"] = str(fd)
        run("/test-bin", "--ignored", "--exact",
            "fips_private_mesh::exit_probe::tests::live_candidate_reaches_dns_and_https_over_its_own_fips_connection",
            pass_fds=(fd, int(os.environ["NVPN_FIXTURE_SELLER_FD"])))
    elif len(sys.argv) == 3:
        run("docker", "run", "--rm", "--pull=never", "--cap-add=NET_ADMIN", "--cap-add=SYS_ADMIN",
            "--security-opt=apparmor=unconfined", "--sysctl=net.ipv4.ip_forward=1",
            "--device=/dev/net/tun", "-v", f"{Path(sys.argv[1]).resolve(strict=True)}:/test-bin:ro",
            "-v", f"{Path(__file__).resolve()}:/fixture:ro", "--entrypoint=python3",
            sys.argv[2], "/fixture", "--seller")
    else:
        raise SystemExit(__doc__)

if __name__ == "__main__":
    main()
