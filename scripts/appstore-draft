    row.get("attributes", {}).get("available") is True
    for row in configured_territories
)
print(
    f"Current App Store territories enabled: {enabled_territories} "
    "(France disabled)"
)
print(f"Build: {BUILD_NUMBER} [{build['id']}]")
print(f"Screenshots {screenshot_mode}: {len(screenshots)}")
