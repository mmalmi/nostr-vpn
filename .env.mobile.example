# Optional local values for mobile smoke tests.
# Copy to .env.mobile.local and keep real device IDs/signing details uncommitted.

# Android physical device or emulator serial. Equivalent to ANDROID_SERIAL.
# NVPN_ANDROID_SERIAL=emulator-5554
# Signed Release joins also require the expected physical model so a stale
# serial cannot silently select a different Android phone.
# NVPN_EXPECTED_ANDROID_DEVICE_MODEL=Pixel model
# Optional local Android smoke setup. Use this when you only need to verify the
# Android OS VPN/TUN path without a preconfigured roster fixture.
# NVPN_ANDROID_DEBUG_CREATE_NETWORK=1
# NVPN_ANDROID_DEBUG_NETWORK_NAME=Android smoke
# Optional for trusted local test devices; taps Android's system VPN consent OK
# button if the prompt appears during `--vpn-cycle`.
# NVPN_ANDROID_ACCEPT_VPN_DIALOG=1
# Android --vpn-cycle copies the app-private Rust runtime-state JSON after the
# OS VPN network becomes active, validates native TUN counter fields, and saves
# Android VPN interface `ip -s link` counters under artifacts/mobile-android.
# NVPN_ANDROID_RUNTIME_STATE_WAIT_SECS=12
# NVPN_ANDROID_RUNTIME_STATE_MAX_AGE_SECS=60
# Android --vpn-cycle also sends a small shell ping probe toward a non-local
# 10.44/16 address and requires tunPacketsRead to increase by at least that
# many packets. Ping output is saved next to the runtime-state artifact so peer
# probe targets preserve packet loss and RTT jitter evidence.
# NVPN_ANDROID_TUN_PACKET_PROBE=1
# NVPN_ANDROID_TUN_PACKET_PROBE_TARGET=10.44.255.254
# NVPN_ANDROID_TUN_PACKET_PROBE_COUNT=4
# Require a reachable peer/exit target to reply through native TUN writes.
# NVPN_ANDROID_TUN_PACKET_PROBE_REQUIRE_REPLY=1
# Full mobile WireGuard exit e2e normally creates these values itself. Override
# only when the Docker fixture endpoint is reachable on a different LAN address.
# NVPN_MOBILE_WG_EXIT_HOST_IP=192.168.1.10
# NVPN_MOBILE_WG_EXIT_HOST_PORT=51886

# iOS physical device identifier for xcrun devicectl.
# NVPN_IOS_DEVICE=00000000-0000000000000000
# Required by the signed Release join gate when multiple phones are paired.
# The private value must exactly match the user-assigned name reported by
# CoreDevice; the gate never guesses which paired phone should be modified.
# NVPN_EXPECTED_IOS_DEVICE_NAME=Release test iPhone
# Build/install the current company Ad Hoc-signed iphoneos app before a physical
# device smoke. Requires App Store Connect profile access for both bundle IDs.
# NVPN_IOS_INSTALL=1
# NVPN_IOS_ALLOW_PROVISIONING_UPDATES=1
# NVPN_IOS_XCODEBUILD_QUIET=1
# Physical gates fail closed on company Ad Hoc signing. Explicit local Xcode
# development builds may opt in to the development mode and identity.
# NVPN_IOS_DEVICE_SIGNING_MODE=development
# NVPN_IOS_DEVICE_CODE_SIGN_IDENTITY=Apple Development
# Optional local iOS VPN/Packet Tunnel smoke setup without peer dataplane coverage.
# NVPN_IOS_DEBUG_CREATE_NETWORK=1
# NVPN_IOS_DEBUG_NETWORK_NAME=iOS smoke
# NVPN_IOS_VPN_START_WAIT_SECS=12
# iOS --vpn-cycle sends a small routed UDP burst and requires tunPacketsRead to increase.
# Require a reachable peer/exit target to reply through native TUN writes.
# NVPN_IOS_TUN_PACKET_PROBE_REQUIRE_REPLY=1

# Optional simulator selection. Set the ID when Xcode has duplicate simulator
# names, or set a full xcodebuild destination string.
# NVPN_IOS_SIMULATOR_ID=00000000-0000-0000-0000-000000000000
# NVPN_IOS_DESTINATION=platform=iOS Simulator,id=00000000-0000-0000-0000-000000000000

# Optional explicit native x86_64 Linux release builder. When HOST is set the
# gate uses only that SSH target and fails closed; it never falls back to local
# Docker/QEMU. Normal SSH known_hosts verification remains mandatory. Configure
# at most one of JUMP and PROXY_COMMAND in the ignored local env.
# NVPN_HOST_LINUX_VM_BUILDER_MODE=remote-native
# NVPN_HOST_LINUX_VM_NATIVE_BUILDER_HOST=release-builder
# NVPN_HOST_LINUX_VM_NATIVE_BUILDER_JUMP=ssh-jump
# NVPN_HOST_LINUX_VM_NATIVE_BUILDER_PROXY_COMMAND=ssh -W %h:%p ssh-jump
# NVPN_HOST_LINUX_VM_RUST_TOOLCHAIN=1.95.0

# Bundle/package overrides for locally signed builds.
# NVPN_ANDROID_PACKAGE=fi.siriusbusiness.nvpn
# NVPN_ANDROID_ACTIVITY=fi.siriusbusiness.nvpn/org.nostrvpn.app.MainActivity
# NVPN_IOS_BUNDLE_ID=fi.siriusbusiness.nvpn
# NVPN_IOS_PACKET_TUNNEL_BUNDLE_ID=fi.siriusbusiness.nvpn.PacketTunnel
# NVPN_IOS_APP_GROUP_IDENTIFIER=group.example.nvpn.shared

# iOS signing/profile knobs used by release/profile scripts. scripts/ios-build
# maps NVPN_IOS_TEAM_ID to xcodebuild DEVELOPMENT_TEAM.
# NVPN_IOS_TEAM_ID=ABCDE12345
# NVPN_IOS_DEVICE_UDIDS=00000000-0000000000000000
# Required by signed Release gates so Xcode cannot silently select a personal
# team/certificate. Keep the real identifiers in the ignored local env.
# NVPN_EXPECTED_IOS_DISTRIBUTION_TEAM_ID=ABCDE12345
# NVPN_EXPECTED_IOS_DISTRIBUTION_CERT_SHA256=64-lowercase-hex-characters
# NVPN_EXPECTED_ANDROID_SIGNER_CERT_SHA256=64-lowercase-hex-characters
# Exact candidate pins are mandatory before the gate can install on either
# physical phone.
# NVPN_EXPECTED_APP_GIT_SHA=40-lowercase-hex-characters
# NVPN_EXPECTED_FIPS_GIT_SHA=40-lowercase-hex-characters
